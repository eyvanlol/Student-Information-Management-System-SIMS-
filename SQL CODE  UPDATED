-- =====================================================================
-- PATCH 4: ENROLMENT — fix status values and constraints
-- =====================================================================

-- Step 1: Update any 'Active' records to 'enrolled'
UPDATE ENROLMENT SET status = 'enrolled' WHERE status = 'Active';
GO

-- Step 2: Drop old default constraint on status dynamically
DECLARE @constraintName NVARCHAR(200);
SELECT @constraintName = dc.name
FROM sys.default_constraints dc
JOIN sys.columns c ON dc.parent_object_id = c.object_id
    AND dc.parent_column_id = c.column_id
JOIN sys.tables t ON c.object_id = t.object_id
WHERE t.name = 'ENROLMENT' AND c.name = 'status';

IF @constraintName IS NOT NULL
    EXEC('ALTER TABLE ENROLMENT DROP CONSTRAINT ' + @constraintName);
GO

-- Step 3: Add new default constraint
IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS WHERE TABLE_NAME = 'ENROLMENT' AND CONSTRAINT_NAME = 'df_enrolment_status')
    ALTER TABLE ENROLMENT ADD CONSTRAINT df_enrolment_status DEFAULT 'pending' FOR status;
GO

-- Step 4: Add CHECK constraint for allowed status values
IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS WHERE TABLE_NAME = 'ENROLMENT' AND CONSTRAINT_NAME = 'chk_enrolment_status')
    ALTER TABLE ENROLMENT ADD CONSTRAINT chk_enrolment_status CHECK (status IN (
        'pending',
        'enrolled',
        'drop_requested',
        'dropped',
        'rejected',
        'confirmed'
    ));
GO


